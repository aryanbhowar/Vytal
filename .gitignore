# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Node / frontend build output (frontend/.gitignore covers more)
node_modules/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example

# Data: never commit survey downloads or generated training tables.
# Small *_summary.json files in datasets/processed/ ARE committed.
datasets/raw/
datasets/interim/
datasets/processed/*.csv
*.parquet
*.zip
*.XPT
*.xpt

# Playwright output (screenshots, traces)
frontend/e2e/.results/
frontend/playwright-report/
frontend/test-results/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
