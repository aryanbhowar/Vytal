# Optional configuration. Vytal needs no secrets or API keys.
# These are read from environment variables; no .env file is loaded automatically.
# Example (PowerShell, before starting the backend):
#   $env:VYTAL_ENABLE_API_DOCS = "false"

# Comma-separated browser origins allowed to call the API directly (CORS).
# Not needed with the Vite dev proxy or in production mode (same origin).
VYTAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Folder containing heart/ and respiratory/ model artifacts.
VYTAL_MODELS_DIR=models

# Interactive API docs at /docs. Set to false in production.
VYTAL_ENABLE_API_DOCS=true

# Largest accepted request body in bytes (a real assessment is under 1 KB).
VYTAL_MAX_REQUEST_BYTES=16384

# Assessments allowed per client IP per minute (0 = no limit).
VYTAL_PREDICT_RATE_LIMIT_PER_MINUTE=30

# Production mode: the backend also serves the built frontend (frontend/dist).
VYTAL_SERVE_FRONTEND=false
VYTAL_FRONTEND_DIST=frontend/dist
