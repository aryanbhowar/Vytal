# Optional configuration. Vytal needs no secrets or API keys.
# These are read from environment variables; no .env file is loaded automatically.
# Example (PowerShell, before starting the backend):
#   $env:VYTAL_ALLOWED_ORIGINS = "http://localhost:5173"

# Comma-separated browser origins allowed to call the API directly (CORS).
# Not needed when using the Vite dev proxy.
VYTAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
