# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Node / frontend build output (frontend/.gitignore covers more)
node_modules/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example

# Data: never commit survey downloads or generated training tables.
# Small *_summary.json files in datasets/processed/ ARE committed.
datasets/raw/
datasets/interim/
datasets/processed/*.csv
*.parquet
*.zip
*.XPT
*.xpt

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
